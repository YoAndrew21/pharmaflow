<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the canonical source, never a separately maintained fixture copy. -->
    <EmbeddedResource Include="../../demo-data/catalog.json"
                      LogicalName="PharmaFlow.Api.CanonicalCatalog.json" />
  </ItemGroup>

</Project>
